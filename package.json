{
  "name": "snip",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": ["web", "capture"],
  "devDependencies": { "miniflare": "5.20261101.0-beta" },
  "scripts": {
    "test": "npm run test:core && npm run test:app",
    "test:core": "node --import tsx --test web/tests/*.test.ts capture/tests/*.test.ts",
    "test:app": "node --test --test-concurrency=1 desktop/tests/*.test.cjs desktop/tests/*.test.mjs",
    "test:desktop": "node desktop/scripts/smoke.cjs",
    "dev": "npm run dev -w web",
    "deploy": "npm run deploy -w web",
    "capture": "npm run start -w capture",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w capture",
    "app": "npm ci --prefix desktop && npm run build -w web && npm run build --prefix desktop",
    "app:dev": "npm start --prefix desktop -- --dev",
    "update": "node scripts/update.mjs",
    "setup:cloudflare": "node scripts/cloudflare.mjs setup",
    "db:migrate:remote": "node scripts/cloudflare.mjs migrate",
    "doctor": "node scripts/doctor.mjs"
  }
}
