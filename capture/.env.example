# URL of the deployed Snip Worker (or http://localhost:5173 in dev)
SNIP_URL=https://snip.YOUR-SUBDOMAIN.workers.dev
# Must match the Worker's CAPTURE_TOKEN secret
CAPTURE_TOKEN=
# Optional: path to a Chrome/Chromium binary (defaults to Playwright's bundled Chromium)
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional: seconds between queue polls
POLL_SECONDS=5
# Optional: set to false to watch the browser work
HEADLESS=true
# Optional: scroll GIF smoothness. Frames per second, pixels scrolled per frame, and a frame cap
# (long pages take bigger steps to stay under the cap). Higher FPS / smaller step = smoother, bigger GIFs.
SCROLL_FPS=30
SCROLL_STEP=40
SCROLL_MAX_FRAMES=360
# Optional: set to false to keep cookie banners and popups in captures
DISMISS_POPUPS=true
