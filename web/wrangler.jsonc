{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Paid (Standard) only: uncomment here after checking your plan; every deploy builds from this file.
  // Free already enforces 10 ms and rejects a custom CPU limit. See docs/cloudflare-cost-controls.md.
  // "limits": { "cpu_ms": 250 },
  // One approximate counter per IP and endpoint in each Cloudflare location.
  // Keep periods at 10 or 60 seconds; responses conservatively ask clients to wait 60 seconds.
  // Namespace ids must be unique within your account if other Workers use rate limiting.
  "ratelimits": [
    { "name": "OAUTH_REGISTER_LIMITER", "namespace_id": "17431001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OAUTH_TOKEN_LIMITER", "namespace_id": "17431002", "simple": { "limit": 60, "period": 60 } },
    { "name": "OAUTH_LOGIN_LIMITER", "namespace_id": "17431003", "simple": { "limit": 30, "period": 60 } },
    { "name": "OAUTH_AUTHORIZE_LIMITER", "namespace_id": "17431004", "simple": { "limit": 30, "period": 60 } }
  ],
  // Hourly sweep of retired capture files (worker/index.ts scheduled).
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/agent/*", "/auth/*", "/files/*", "/transfer/*", "/mcp", "/mcp/*",
      "/authorize", "/token", "/register", "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snip",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "snip-files" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    // Comma-separated GitHub logins allowed to sign in. Read only when GITHUB_CLIENT_ID and
    // GITHUB_CLIENT_SECRET are both set: a new install signs in with a passkey and never
    // configures them, while an install that already had GitHub sign-in keeps working.
    "ALLOWED_GITHUB_LOGINS": "your-github-login",
    // Public origin of the deployed Worker, used as the MCP OAuth resource id.
    "PUBLIC_URL": "https://snip.YOUR-SUBDOMAIN.workers.dev"
  }
  // Secrets (wrangler secret put / .dev.vars):
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET: optional; GitHub routes mount only when both exist.
  //   SESSION_SECRET, CAPTURE_TOKEN, OWNER_LINK_SECRET: required. OWNER_LINK_SECRET is separate so
  //   rotating it does not invalidate sessions or signed file URLs.
  //   TRANSFER_TOKEN: only during a move or pull; /transfer/* 404s without it.
  // `npm run cf-typegen` regenerates worker/worker-configuration.d.ts. Every name above must be
  // present in .dev.vars for the run, or its binding disappears from the generated Env.
}
