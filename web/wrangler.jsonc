{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/agent/*", "/auth/*", "/files/*", "/mcp", "/mcp/*",
      "/authorize", "/token", "/register", "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snip",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "snip-files" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    // Comma-separated GitHub logins allowed to sign in.
    "ALLOWED_GITHUB_LOGINS": "MaxChen04",
    // Public origin of the deployed Worker, used as the MCP OAuth resource id.
    "PUBLIC_URL": "https://snip.YOUR-SUBDOMAIN.workers.dev"
  }
  // Secrets (wrangler secret put / .dev.vars):
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET, CAPTURE_TOKEN
}
