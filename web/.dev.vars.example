GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
SESSION_SECRET=generate-with-openssl-rand-hex-32
CAPTURE_TOKEN=generate-with-openssl-rand-hex-32
# Owner link HMAC. Kept separate from SESSION_SECRET so rotating one does not break the other.
OWNER_LINK_SECRET=generate-with-openssl-rand-hex-32
# Local only: skip GitHub login and act as this user (never set in production)
DEV_LOGIN=your-github-login
PUBLIC_URL=http://localhost:5173
